# Copier ce fichier en ".env" (a cote de app.py) et adapter les valeurs.
# NE PAS committer le fichier ".env" reel (mot de passe en clair) dans un
# depot partage / synchronise publiquement.

SECRET_KEY=change-moi-en-une-longue-chaine-aleatoire

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=yvallet_base
MYSQL_USER=root
MYSQL_PASSWORD=saanar

# Repertoire ou seront ecrits les CSV d'export (import VIF) et les
# sauvegardes SQL completes
CSV_EXPORT_DIR=C:\58_ramasse

# Il n'y a plus de CODE_BA fixe ici (fonctionnalite absente de l'original) :
# chaque utilisateur est desormais rattache a un CODE_BA via son compte de
# connexion (menu Utilisateurs, reserve a l'administrateur - voir plus bas).

# Chemin de l'executable mysqldump (sauvegarde SQL complete de la base,
# voir Administration > Sauvegarde). A adapter si mysqldump.exe n'est pas
# dans le PATH systeme, par exemple :
# MYSQLDUMP_PATH=C:\Program Files\MySQL\MySQL Server 8.0\bin\mysqldump.exe
MYSQLDUMP_PATH=mysqldump

# --------------------------------------------------------------------- #
# Authentification multi-site (fonctionnalite absente de l'original) :
# rien a configurer ici, mais 2 points importants avant la mise en service :
#
# 1. Executez migration_login_multi_ba.sql sur votre base MySQL (une seule
#    fois) : il cree la table `user` et ajoute la colonne CODE_BA aux
#    tables histo/modeles.
# 2. Au premier demarrage de l'application apres la migration, un compte
#    administrateur par defaut est cree automatiquement :
#      login = yvmaison@free.fr / mot de passe = admin / CODE_BA = 00
#    Connectez-vous avec ce compte et changez IMMEDIATEMENT son mot de
#    passe (menu Utilisateurs), puis creez un compte par site (CODE_BA).
# --------------------------------------------------------------------- #
