# Copier ce fichier en ".env" (a cote de app.py) et adapter les valeurs.
# NE PAS committer le fichier ".env" reel (mot de passe en clair) dans un
# depot partage / synchronise publiquement.

SECRET_KEY=change-moi-en-une-longue-chaine-aleatoire

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=yvallet_base
MYSQL_USER=root
MYSQL_PASSWORD=saanar

# Repertoire ou seront ecrits les CSV d'export (import VIF)
CSV_EXPORT_DIR=C:\58_ramasse

# Code BA (equivalent code_BA de param_ramasse.txt)
CODE_BA=58

# Chemin de l'executable mysqldump (sauvegarde SQL complete de la base,
# voir Administration > Sauvegarde). A adapter si mysqldump.exe n'est pas
# dans le PATH systeme, par exemple :
MYSQLDUMP_PATH=C:\Program Files\MySQL\MySQL Server 5.7\bin\mysqldump.exe
#MYSQLDUMP_PATH=mysqldump
